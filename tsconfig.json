{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"outDir": "dist",
		"rootDir": "./src",
		"removeComments": true,
		"strict": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}